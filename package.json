{
  "name": "fft-visualizer-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the FFT Visualizer family: a framework-agnostic WebGL spectrum-analyzer core and its framework wrappers",
  "scripts": {
    "dev": "pnpm --filter @fft-visualizer/playground-vue dev",
    "dev:core": "pnpm --filter @fft-visualizer/playground-core dev",
    "dev:react": "pnpm --filter @fft-visualizer/playground-react dev",
    "dev:nuxt": "pnpm --filter @fft-visualizer/playground-nuxt dev",
    "build": "pnpm -r build",
    "build:wasm": "pnpm --filter @fft-visualizer/core build:wasm",
    "build:playground": "bash scripts/build-playground-site.sh",
    "preview": "vite preview --config playground/site/vite.config.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:node": "pnpm --filter @fft-visualizer/core test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && changeset publish && bash scripts/create-github-releases.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
