{
  "name": "fft-visualizer-react",
  "version": "0.4.0",
  "description": "A high-performance, WebGL-based real-time audio spectrum analyzer and FFT visualizer component for React — microphone, tab/system audio, WebSocket, or your own Web Audio data",
  "type": "module",
  "module": "./dist/fft-visualizer-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fft-visualizer-react.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/fft-wasm.js"
    },
    "./style.css": "./dist/fft-visualizer-react.css"
  },
  "style": "./dist/fft-visualizer-react.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "fft-visualizer-core": "workspace:^"
  },
  "keywords": [
    "react",
    "audio-visualizer",
    "audio-spectrum",
    "spectrum-analyzer",
    "spectrum",
    "music-visualizer",
    "audio-visualization",
    "web-audio",
    "fft",
    "frequency",
    "microphone",
    "real-time",
    "webgl",
    "visualizer",
    "analyzer",
    "audio-visualiser",
    "spectrum-analyser",
    "visualiser"
  ],
  "author": "Wouter Vernaillen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonics-audio/fft-visualizer.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/harmonics-audio/fft-visualizer/issues"
  },
  "homepage": "https://github.com/harmonics-audio/fft-visualizer#readme"
}
