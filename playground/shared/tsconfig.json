{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@fft-visualizer/core": ["../../packages/core/src/index.ts"],
      "@fft-visualizer/core/wasm": ["../../packages/core/src/wasm.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
